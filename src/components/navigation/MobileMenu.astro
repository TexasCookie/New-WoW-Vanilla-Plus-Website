---
/* ==========================================================================
   VanillaPlus — MobileMenu Component
   Hamburger slide-out with accordion sub-items
   Pure vanilla JS — no React/framework dependencies
   ========================================================================== */

import { mainNavItems } from '@utils/navigation';
---

<div class="lg:hidden">
  <!-- Hamburger Button -->
  <button
    id="mobile-menu-toggle"
    type="button"
    class="relative z-[60] flex flex-col justify-center items-center gap-[5px] w-10 h-10 cursor-pointer"
    aria-label="Toggle menu"
    aria-expanded="false"
  >
    <span class="hamburger-bar block w-6 h-[2px] bg-white transition-all duration-300 origin-center"></span>
    <span class="hamburger-bar block w-6 h-[2px] bg-white transition-all duration-300 origin-center"></span>
    <span class="hamburger-bar block w-6 h-[2px] bg-white transition-all duration-300 origin-center"></span>
  </button>

  <!-- Overlay -->
  <div
    id="mobile-overlay"
    class="fixed inset-0 bg-black/50 z-[55] opacity-0 invisible transition-all duration-300"
  ></div>

  <!-- Slide-out Panel -->
  <div
    id="mobile-panel"
    class="mobile-panel fixed top-0 left-0 w-[280px] h-full overflow-y-auto z-[58] transform -translate-x-full transition-transform duration-300 ease-in-out"
    style="background: rgba(24,20,18,0.98);"
  >
    <!-- Panel Header -->
    <div class="flex items-center justify-between px-5 py-4 border-b border-wow-border">
      <a href="/" class="font-heading text-lg font-bold gradient-text tracking-widest">
        VANILLA+
      </a>
    </div>

    <!-- Nav Items -->
    <nav class="py-2">
      {mainNavItems.map((item, index) => (
        <div class="mobile-nav-item border-b border-wow-border last:border-b-0">
          {item.items && item.items.length > 0 ? (
            <div>
              <button
                type="button"
                class="mobile-accordion-trigger flex items-center justify-between w-full px-5 py-4 uppercase text-sm tracking-wider text-wow-muted hover:text-wow-accent transition-colors duration-200 font-heading"
                data-index={index}
              >
                <span>{item.label}</span>
                <svg
                  class="accordion-icon w-4 h-4 transition-transform duration-200"
                  fill="none"
                  viewBox="0 0 24 24"
                  stroke="currentColor"
                  stroke-width="2"
                >
                  <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
                </svg>
              </button>
              <div class="accordion-content overflow-hidden max-h-0 transition-all duration-300 ease-in-out">
                <a
                  href={item.href}
                  class="block px-8 py-2.5 text-sm text-wow-muted hover:text-wow-accent transition-colors duration-150"
                >
                  Overview
                </a>
                {item.items.map((subItem) => (
                  <a
                    href={subItem.href}
                    class="block px-8 py-2.5 text-sm text-wow-muted hover:text-wow-accent transition-colors duration-150"
                  >
                    {subItem.label}
                  </a>
                ))}
              </div>
            </div>
          ) : (
            <a
              href={item.href}
              class="block px-5 py-4 uppercase text-sm tracking-wider text-wow-muted hover:text-wow-accent transition-colors duration-200 font-heading"
              {...(item.external ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
            >
              {item.label}
            </a>
          )}
        </div>
      ))}
    </nav>

    <!-- Login Button -->
    <div class="px-5 py-6">
      <a
        href="/account/login"
        class="block w-full text-center px-5 py-3 border border-wow-border text-wow-accent uppercase text-sm tracking-wider font-heading hover:bg-wow-accent hover:text-wow-bg transition-colors duration-200"
      >
        Login
      </a>
    </div>
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const toggle = document.getElementById('mobile-menu-toggle');
    const panel = document.getElementById('mobile-panel');
    const overlay = document.getElementById('mobile-overlay');

    if (!toggle || !panel || !overlay) return;

    let isOpen = false;

    function openMenu(): void {
      isOpen = true;
      toggle!.classList.add('open');
      toggle!.setAttribute('aria-expanded', 'true');
      panel!.classList.remove('-translate-x-full');
      panel!.classList.add('translate-x-0');
      overlay!.classList.remove('opacity-0', 'invisible');
      overlay!.classList.add('opacity-100', 'visible');
      document.body.style.overflow = 'hidden';
    }

    function closeMenu(): void {
      isOpen = false;
      toggle!.classList.remove('open');
      toggle!.setAttribute('aria-expanded', 'false');
      panel!.classList.remove('translate-x-0');
      panel!.classList.add('-translate-x-full');
      overlay!.classList.remove('opacity-100', 'visible');
      overlay!.classList.add('opacity-0', 'invisible');
      document.body.style.overflow = '';
    }

    toggle.addEventListener('click', () => {
      isOpen ? closeMenu() : openMenu();
    });

    overlay.addEventListener('click', closeMenu);

    // Accordion toggles
    const accordionTriggers = document.querySelectorAll('.mobile-accordion-trigger');

    accordionTriggers.forEach((trigger) => {
      trigger.addEventListener('click', () => {
        const content = trigger.nextElementSibling as HTMLElement | null;
        const icon = trigger.querySelector('.accordion-icon') as SVGElement | null;
        if (!content) return;

        const isExpanded = content.style.maxHeight && content.style.maxHeight !== '0px';

        if (isExpanded) {
          content.style.maxHeight = '0px';
          icon?.classList.remove('rotate-180');
        } else {
          content.style.maxHeight = content.scrollHeight + 'px';
          icon?.classList.add('rotate-180');
        }
      });
    });
  });
</script>

<style>
  /* Hamburger → X animation */
  #mobile-menu-toggle.open .hamburger-bar:nth-child(1) {
    transform: translateY(7px) rotate(45deg);
  }

  #mobile-menu-toggle.open .hamburger-bar:nth-child(2) {
    opacity: 0;
  }

  #mobile-menu-toggle.open .hamburger-bar:nth-child(3) {
    transform: translateY(-7px) rotate(-45deg);
  }
</style>
