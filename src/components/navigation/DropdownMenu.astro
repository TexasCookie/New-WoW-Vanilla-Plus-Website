---
/* ==========================================================================
   VanillaPlus — DropdownMenu Component
   Hover-based dropdown with optional sub-item fly-out (children)
   ========================================================================== */

import type { NavSubItem } from '@utils/navigation';

interface Props {
  label: string;
  href?: string;
  items?: NavSubItem[];
}

const { label, href, items = [] } = Astro.props;
const hasDropdown = items.length > 0;
---

{hasDropdown ? (
  <div class="nav-dropdown relative">
    <button
      type="button"
      class="flex items-center gap-1 uppercase text-sm tracking-wider text-wow-muted hover:text-wow-accent transition-colors duration-200 font-heading"
    >
      {label}
      <svg
        class="w-3 h-3 mt-0.5 transition-transform duration-200"
        fill="none"
        viewBox="0 0 24 24"
        stroke="currentColor"
        stroke-width="2"
      >
        <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
      </svg>
    </button>

    <div class="nav-dropdown-menu absolute top-full left-0 pt-2 opacity-0 invisible -translate-y-2 transition-all duration-200 ease-out z-50 pointer-events-none">
      <ul class="min-w-[200px] border border-wow-border py-1" style="background: rgba(24,20,18,0.95); backdrop-filter: blur(8px);">
        {items.map((item) => (
          <li class="relative group/item">
            <a
              href={item.href}
              class="flex items-center justify-between p-3 px-5 text-sm text-wow-muted hover:bg-[#333] hover:text-wow-accent transition-colors duration-150"
            >
              <span>{item.label}</span>
              {item.children && item.children.length > 0 && (
                <svg
                  class="w-3 h-3 ml-2"
                  fill="none"
                  viewBox="0 0 24 24"
                  stroke="currentColor"
                  stroke-width="2"
                >
                  <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
                </svg>
              )}
            </a>
            {item.children && item.children.length > 0 && (
              <div class="nav-submenu absolute top-0 left-full pl-1 opacity-0 invisible -translate-x-1 transition-all duration-200 ease-out pointer-events-none group-hover/item:opacity-100 group-hover/item:visible group-hover/item:translate-x-0 group-hover/item:pointer-events-auto">
                <ul class="min-w-[180px] border border-wow-border py-1" style="background: rgba(24,20,18,0.95); backdrop-filter: blur(8px);">
                  {item.children.map((child) => (
                    <li>
                      <a
                        href={child.href}
                        class="block p-3 px-5 text-sm text-wow-muted hover:bg-[#333] hover:text-wow-accent transition-colors duration-150"
                      >
                        {child.label}
                      </a>
                    </li>
                  ))}
                </ul>
              </div>
            )}
          </li>
        ))}
      </ul>
    </div>
  </div>
) : (
  <a
    href={href}
    class="uppercase text-sm tracking-wider text-wow-muted hover:text-wow-accent transition-colors duration-200 font-heading"
  >
    {label}
  </a>
)}
