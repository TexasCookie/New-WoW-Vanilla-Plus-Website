---
const communityLinks = [
  {
    label: 'Discord',
    icon: '&#128172;',
    description: 'Join 10,000+ players in our active Discord community.',
    href: 'https://discord.gg/e34ugkqnWG',
  },
  {
    label: 'Wiki',
    icon: '&#128218;',
    description: 'Guides, class info, and server documentation.',
    href: '/wiki',
  },
  {
    label: 'Bug Tracker',
    icon: '&#128027;',
    description: 'Report issues and track bug fixes.',
    href: '/bugtracker',
  },
  {
    label: 'Patreon',
    icon: '&#10084;',
    description: 'Support the server and unlock perks.',
    href: 'https://patreon.com/vanillaplus',
  },
];
---

<section class="py-16">
  <div class="max-w-[1440px] mx-auto px-4">
    <h2 class="gradient-text text-3xl uppercase mb-8">Community</h2>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
      {communityLinks.map((link) => (
        <a
          href={link.href}
          class="card-dark p-6 text-center block transition-all duration-300 hover:shadow-[0_0_20px_rgba(241,194,45,0.1)] hover:border-wow-gold/30 group"
          {...(link.href.startsWith('http') ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
        >
          <div class="text-4xl mb-4 group-hover:scale-110 transition-transform duration-300">
            <span set:html={link.icon} />
          </div>
          <h3 class="text-white uppercase text-sm tracking-wide mb-2 group-hover:text-wow-accent transition-colors">
            {link.label}
          </h3>
          <p class="text-wow-muted text-sm leading-relaxed">
            {link.description}
          </p>
        </a>
      ))}
    </div>
  </div>
</section>
