---
interface Feature {
  title: string;
  description: string;
  icon?: string;
  href?: string;
}

interface Props {
  features: Feature[];
}

const { features } = Astro.props;
---

<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
  {features.map((feature) => (
    <a
      href={feature.href || '#'}
      class="card-dark p-6 block transition-all duration-300 hover:shadow-[0_0_20px_rgba(241,194,45,0.08)] hover:border-wow-gold/20"
    >
      <div class="w-10 h-10 rounded-full bg-wow-accent/10 text-wow-accent flex items-center justify-center mb-4 text-sm font-bold">
        {feature.icon || feature.title.charAt(0)}
      </div>
      <h3 class="text-white uppercase mb-2 text-sm tracking-wide">
        {feature.title}
      </h3>
      <p class="text-wow-muted text-sm leading-relaxed">
        {feature.description}
      </p>
    </a>
  ))}
</div>
