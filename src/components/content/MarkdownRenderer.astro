---
/* MarkdownRenderer — Styled markdown content wrapper */
---

<div class="markdown-content">
  <slot />
</div>

<style>
  .markdown-content :global(h2) {
    font-size: 1.5rem;
    font-family: var(--font-heading);
    text-transform: uppercase;
    color: white;
    margin-top: 3rem;
    margin-bottom: 1rem;
    position: relative;
  }

  .markdown-content :global(h2)::after {
    content: '';
    display: block;
    height: 1px;
    background: linear-gradient(90deg, transparent, var(--color-wow-gold), transparent);
    margin-top: 0.75rem;
  }

  .markdown-content :global(h3) {
    font-size: 1.25rem;
    font-family: var(--font-heading);
    text-transform: uppercase;
    color: white;
    margin-top: 2rem;
    margin-bottom: 0.75rem;
  }

  .markdown-content :global(p) {
    color: var(--color-wow-muted);
    line-height: 1.75;
    margin-bottom: 1rem;
  }

  .markdown-content :global(a) {
    color: var(--color-wow-accent);
    text-decoration-offset: 2px;
    transition: color 0.2s ease;
  }

  .markdown-content :global(a):hover {
    color: var(--color-wow-gold);
    text-decoration: underline;
  }

  .markdown-content :global(ul),
  .markdown-content :global(ol) {
    color: var(--color-wow-muted);
    padding-left: 1.5rem;
    margin-bottom: 1rem;
  }

  .markdown-content :global(ul) li,
  .markdown-content :global(ol) li {
    margin-bottom: 0.5rem;
  }

  .markdown-content :global(ul) li::marker {
    color: var(--color-wow-gold);
  }

  .markdown-content :global(code) {
    background-color: var(--color-wow-input);
    color: var(--color-wow-accent);
    padding: 0.125rem 0.375rem;
    font-size: 0.875rem;
    border-radius: 0.125rem;
  }

  .markdown-content :global(pre) {
    background-color: var(--color-wow-input);
    border: 1px solid var(--color-wow-border);
    padding: 1rem;
    overflow-x: auto;
    margin-bottom: 1rem;
  }

  .markdown-content :global(pre) code {
    background: none;
    padding: 0;
    font-size: 0.875rem;
  }

  .markdown-content :global(blockquote) {
    border-left: 2px solid var(--color-wow-gold);
    background-color: var(--color-wow-surface);
    padding: 1rem;
    font-style: italic;
    color: var(--color-wow-muted);
  }

  .markdown-content :global(img) {
    border-radius: 0.25rem;
    border: 1px solid var(--color-wow-border);
    max-width: 100%;
    margin-top: 1.5rem;
    margin-bottom: 1.5rem;
  }

  .markdown-content :global(table) {
    width: 100%;
    border-collapse: collapse;
  }

  .markdown-content :global(th) {
    background-color: var(--color-wow-surface);
    color: white;
    padding: 0.75rem;
    text-align: left;
    text-transform: uppercase;
    font-size: 0.875rem;
  }

  .markdown-content :global(td) {
    border-top: 1px solid var(--color-wow-border);
    padding: 0.75rem;
    color: var(--color-wow-muted);
  }

  .markdown-content :global(hr) {
    border: 0;
    height: 1px;
    background: linear-gradient(90deg, transparent, var(--color-wow-gold), transparent);
    margin-top: 2rem;
    margin-bottom: 2rem;
  }
</style>
