---
import Badge from '../common/Badge.astro';

interface Props {
  title: string;
  description?: string;
  date?: Date;
  category?: string;
  author?: string;
}

const { title, description, date, category, author } = Astro.props;

const formattedDate = date
  ? date.toLocaleDateString('en-US', {
      month: 'long',
      day: 'numeric',
      year: 'numeric',
    })
  : null;
---

<div class="max-w-[1440px] mx-auto px-4 pt-16 pb-8">
  <h1 class="text-4xl font-heading uppercase text-white mb-4">{title}</h1>

  <!-- Gold underline -->
  <div class="h-[2px] w-24 bg-gradient-to-r from-wow-gold to-wow-gold-end mb-6"></div>

  <!-- Meta row -->
  {(date || category || author) && (
    <div class="flex gap-4 items-center text-sm text-wow-faint">
      {formattedDate && <time datetime={date!.toISOString()}>{formattedDate}</time>}
      {category && <Badge text={category} variant="warning" />}
      {author && <span>By {author}</span>}
    </div>
  )}

  {description && (
    <p class="text-wow-muted mt-4 max-w-2xl">{description}</p>
  )}
</div>
