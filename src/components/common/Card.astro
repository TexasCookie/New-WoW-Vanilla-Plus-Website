---
interface Props {
  title?: string;
  image?: string;
  href?: string;
}

const { title, image, href } = Astro.props;

const Tag = href ? 'a' : 'div';
---

{image ? (
  <Tag href={href} class:list={['group relative overflow-hidden bg-cover bg-center transition-all duration-200 hover:shadow-[0_0_15px_rgba(248,157,65,0.15)]', 'block']}>
    <div class="absolute inset-0 bg-cover bg-center" style={`background-image: url('${image}')`}></div>
    <div class="absolute inset-0 bg-[#100d0c] opacity-50"></div>
    <div class="relative z-10 p-6">
      {title && <h3 class="gradient-text font-heading uppercase mb-2">{title}</h3>}
      <slot />
    </div>
  </Tag>
) : (
  <Tag
    href={href}
    class:list={[
      'group bg-[rgba(24,20,18,0.95)] border border-[rgba(158,151,131,0.1)] overflow-hidden transition-all duration-200 hover:shadow-[0_0_15px_rgba(248,157,65,0.15)]',
      'block',
      'p-6',
    ]}
  >
    {title && <h3 class="gradient-text font-heading uppercase mb-3">{title}</h3>}
    <slot />
  </Tag>
)}
