---
// src/components/nodes/NewsFeed.astro
// Русский: Лента новостей
// English: News feed

import { translations, type Lang } from '../content/translations';

const { currentLang = 'ru' } = Astro.props;
const lang: Lang = currentLang as Lang;
const t = translations[lang].news;

const news = [
  {
    title: currentLang === 'ru' ? "Vanilla Plus запущен!" : "Vanilla Plus is LIVE!",
    date: currentLang === 'ru' ? "29 марта 2026" : "March 29, 2026",
    desc: currentLang === 'ru' ? "Сервер официально открыт. Создавай персонажа!" : "The server is officially open. Create your character!",
    link: "/news/launch"
  }
];
---

<section class="node-section news-section">
  <div class="container">
    <h2 class="node-title">{t.title}</h2>
    
    <div class="news-grid">
      {news.map((item) => (
        <a href={item.link} class="news-card">
          <div class="news-date">{item.date}</div>
          <h3>{item.title}</h3>
          <p>{item.desc}</p>
          <span class="read-more">{t.readMore}</span>
        </a>
      ))}
    </div>
  </div>
</section>

<style>
  .news-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(340px, 1fr));
    gap: 2rem;
    max-width: 1200px;
    margin: 0 auto;
  }
  .news-card {
    background: #1a1a1a;
    border: 2px solid #ffd700;
    border-radius: 16px;
    padding: 1.8rem;
    text-decoration: none;
    color: white;
    transition: all 0.3s;
  }
  .news-card:hover {
    transform: translateY(-6px);
    border-color: #00ff9d;
  }
  .news-date {
    color: #00ff9d;
    font-size: 0.95rem;
    margin-bottom: 0.8rem;
  }
  .news-card h3 {
    color: #ffd700;
    font-size: 1.4rem;
    margin-bottom: 1rem;
  }
  .read-more {
    color: #ffd700;
    font-weight: 700;
    font-size: 1rem;
  }
</style>