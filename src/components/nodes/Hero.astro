---
// src/components/nodes/Hero.astro
// Русский: Главный герой-блок на всю высоту экрана
// English: Main hero section (full-screen banner)

import { translations, type Lang } from '../content/translations';
import { siteConfig } from '../content/config';

const { currentLang = 'ru' } = Astro.props;
const lang: Lang = currentLang as Lang;
const t = translations[lang].hero;
const { hero } = siteConfig;
---

<section class="hero">
  <div class="hero-bg" style={`background-image: url(${hero.backgroundImage})`}></div>
  
  <div class="hero-content">
    <h1 class="hero-title">{hero.title}</h1>
    <p class="hero-subtitle">{t.subtitle}</p>
    
    <div class="hero-buttons">
      <a href={hero.buttons[0].link} class="btn btn-primary">{t.download}</a>
      <a href={hero.buttons[1].link} class="btn btn-secondary">{t.discord}</a>
    </div>
  </div>
</section>

<style>
  .hero {
    height: 100vh;
    min-height: 600px;
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    overflow: hidden;
    color: white;
  }
  .hero-bg {
    position: absolute;
    inset: 0;
    background-size: cover;
    background-position: center;
    filter: brightness(0.4);
    z-index: 1;
  }
  .hero-content {
    position: relative;
    z-index: 2;
    max-width: 900px;
    padding: 0 2rem;
  }
  .hero-title {
    font-size: 5rem;
    font-weight: 900;
    letter-spacing: 0.1em;
    color: #ffd700;
    text-shadow: 0 0 30px rgba(255, 215, 0, 0.6);
    margin-bottom: 1rem;
  }
  .hero-subtitle {
    font-size: 1.8rem;
    margin-bottom: 3rem;
    opacity: 0.9;
  }
  .hero-buttons {
    display: flex;
    gap: 1.5rem;
    justify-content: center;
    flex-wrap: wrap;
  }
  .btn {
    padding: 1rem 2.5rem;
    font-size: 1.3rem;
    border-radius: 9999px;
    text-decoration: none;
    font-weight: 700;
    transition: all 0.3s;
  }
  .btn-primary {
    background: #ffd700;
    color: #111;
  }
  .btn-secondary {
    background: transparent;
    color: white;
    border: 3px solid #ffd700;
  }
  .btn:hover {
    transform: scale(1.05);
  }
</style>