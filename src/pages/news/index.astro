---
import ContentLayout from '../../layouts/ContentLayout.astro';
import { getCollection } from 'astro:content';
import { formatDate } from '../../utils/seo';
import Card from '../../components/common/Card.astro';
import Badge from '../../components/common/Badge.astro';

const allNews = (await getCollection('news', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<ContentLayout title="News — VanillaPlus" description="Latest updates, patch notes, and announcements from VanillaPlus.">
  <section class="max-w-6xl mx-auto px-4 py-16">
    <h1 class="text-4xl font-heading font-bold text-[#c8c0b8] mb-2">News</h1>
    <p class="text-lg text-[#7a7168] mb-12">Latest updates, patch notes, and announcements.</p>

    <div class="grid gap-6 md:grid-cols-2">
      {allNews.map((post) => (
        <Card href={`/news/${post.id}`}>
          <div class="p-6">
            <div class="flex items-center gap-3 mb-3">
              <Badge>{post.data.category}</Badge>
              <time class="text-sm text-[#7a7168]" datetime={post.data.pubDate.toISOString()}>
                {formatDate(post.data.pubDate)}
              </time>
            </div>
            <h2 class="text-xl font-heading font-semibold text-[#c8c0b8] mb-2">{post.data.title}</h2>
            <p class="text-[#9c938b] leading-relaxed">{post.data.description}</p>
          </div>
        </Card>
      ))}
    </div>
  </section>
</ContentLayout>
