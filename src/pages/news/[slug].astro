---
import { getEntry, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

const slug = Astro.params.slug;
const entry = slug ? await getEntry('news', slug) : undefined;

if (!entry) {
  Astro.response.status = 404;
}

const rendered = entry ? await render(entry) : null;
const Content = rendered?.Content;
---

<BaseLayout title={entry ? entry.data.title : 'News not found'} description={entry?.data.excerpt}>
  {entry && Content ? (
    <>
      <section class="page-hero container narrow">
        <p class="eyebrow">{entry.data.heroLabel ?? entry.data.category}</p>
        <h1>{entry.data.title}</h1>
        <p>{entry.data.excerpt}</p>
        <p class="news-date">{entry.data.pubDate.toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' })}</p>
      </section>

      <article class="container narrow section-block prose-shell">
        <Content />
      </article>
    </>
  ) : (
    <section class="page-hero container narrow">
      <p class="eyebrow">News</p>
      <h1>Post not found</h1>
      <p>This news entry does not exist yet. Return to the newsroom to pick another post.</p>
      <a class="button button-primary" href="/news">Back to news</a>
    </section>
  )}
</BaseLayout>
