---
import ContentLayout from '../layouts/ContentLayout.astro';
import { getCollection } from 'astro:content';

const allRewards = await getCollection('rewards');
---

<ContentLayout title="Donor Rewards — VanillaPlus" description="Support VanillaPlus development and get exclusive rewards.">
  <section class="max-w-6xl mx-auto px-4 py-16">
    <h1 class="text-4xl font-heading font-bold text-[#c8c0b8] mb-2">Donor Rewards</h1>
    <p class="text-lg text-[#7a7168] mb-12">Support the server and earn exclusive in-game rewards as our thanks.</p>

    <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
      {allRewards.map((reward) => (
        <div class="border border-[#2a2420] rounded-lg bg-[#1a1614] p-6 hover:border-[#d4a847] transition-colors">
          <div class="flex items-center justify-between mb-4">
            <span class="text-xs uppercase tracking-wider text-[#d4a847] font-semibold">{reward.data.tier}</span>
            <span class="text-sm text-[#7a7168]">{reward.data.amount}</span>
          </div>
          <h2 class="text-xl font-heading font-semibold text-[#c8c0b8] mb-2">{reward.data.title}</h2>
          <p class="text-[#9c938b] leading-relaxed mb-4">{reward.data.description}</p>
          <a
            href="https://www.patreon.com/VanillaPlus"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-block px-4 py-2 bg-[#d4a847] text-[#100d0c] text-sm font-semibold rounded hover:bg-[#e0b84f] transition-colors"
          >
            Support Us
          </a>
        </div>
      ))}
    </div>
  </section>
</ContentLayout>
