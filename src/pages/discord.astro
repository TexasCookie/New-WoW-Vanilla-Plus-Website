---
import { siteConfig } from '../config/site';
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Discord">
  <section class="page-hero container narrow">
    <p class="eyebrow">Community hub</p>
    <h1>Make Discord a real entry point, not a buried external link.</h1>
    <p>
      Use this page for invites, server rules, support channels, event channels, role info, and launcher troubleshooting.
      It is also a good place to later connect Discord OAuth and role sync to the website account system.
    </p>
    <div class="hero-actions compact">
      <a class="button button-primary" href={siteConfig.discordUrl} target="_blank" rel="noreferrer">Join Discord</a>
      <a class="button button-secondary" href="/account/register">Create account first</a>
    </div>
  </section>

  <section class="container section-block card-grid three-up">
    <article class="info-card">
      <h2>Support channels</h2>
      <p>Point new players to install help, launcher troubleshooting, password recovery, and report flow.</p>
    </article>
    <article class="info-card">
      <h2>Community events</h2>
      <p>Promote guild recruitment, PvP nights, patch previews, and seasonal announcements.</p>
    </article>
    <article class="info-card">
      <h2>Discord OAuth later</h2>
      <p>Link website accounts to Discord identities and sync supporter or tester roles from your backend.</p>
    </article>
  </section>
</BaseLayout>
