---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Reset Password — VanillaPlus" description="Reset your VanillaPlus account password.">
  <section class="min-h-[80vh] flex items-center justify-center px-4">
    <div class="w-full max-w-md">
      <div class="text-center mb-8">
        <h1 class="text-3xl font-heading font-bold text-[#c8c0b8] mb-2">Reset Password</h1>
        <p class="text-[#7a7168]">Enter your credentials to receive a password reset link.</p>
      </div>

      <form action="/password" method="post" class="space-y-5">
        <div>
          <label for="username" class="block text-sm font-medium text-[#9c938b] mb-1.5">Username</label>
          <input
            type="text"
            id="username"
            name="username"
            required
            class="w-full px-4 py-2.5 bg-[#1a1614] border border-[#2a2420] rounded-lg text-[#c8c0b8] placeholder-[#5a534b] focus:outline-none focus:border-[#d4a847] transition-colors"
            placeholder="Your account name"
          />
        </div>

        <div>
          <label for="email" class="block text-sm font-medium text-[#9c938b] mb-1.5">Email Address</label>
          <input
            type="email"
            id="email"
            name="email"
            required
            class="w-full px-4 py-2.5 bg-[#1a1614] border border-[#2a2420] rounded-lg text-[#c8c0b8] placeholder-[#5a534b] focus:outline-none focus:border-[#d4a847] transition-colors"
            placeholder="your@email.com"
          />
        </div>

        <button
          type="submit"
          class="w-full py-2.5 bg-[#d4a847] text-[#100d0c] font-semibold rounded-lg hover:bg-[#e0b84f] transition-colors cursor-pointer"
        >
          Send Reset Link
        </button>
      </form>

      <p class="text-center text-sm text-[#7a7168] mt-6">
        <a href="/" class="text-[#d4a847] hover:underline">Return to Home</a>
      </p>
    </div>
  </section>
</BaseLayout>
