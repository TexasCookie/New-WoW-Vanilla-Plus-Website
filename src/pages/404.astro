---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="404 — Page Not Found" description="The page you're looking for doesn't exist.">
  <section class="min-h-[80vh] flex items-center justify-center px-4">
    <div class="text-center">
      <p class="text-[10rem] leading-none font-heading font-bold bg-gradient-to-r from-[#d4a847] to-[#a07830] bg-clip-text text-transparent select-none">
        404
      </p>
      <h1 class="text-3xl font-heading font-semibold text-[#c8c0b8] mt-4 mb-4">Page Not Found</h1>
      <p class="text-[#7a7168] mb-8">The page you're looking for doesn't exist or has been moved.</p>
      <a
        href="/"
        class="inline-block px-6 py-3 bg-[#d4a847] text-[#100d0c] font-semibold rounded-lg hover:bg-[#e0b84f] transition-colors"
      >
        Return Home
      </a>
    </div>
  </section>
</BaseLayout>
