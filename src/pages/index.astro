---
import { getCollection } from 'astro:content';
import FeatureGrid from '../components/FeatureGrid.astro';
import NewsList from '../components/NewsList.astro';
import SectionHeading from '../components/SectionHeading.astro';
import ServerStatus from '../components/ServerStatus';
import { siteConfig } from '../config/site';
import BaseLayout from '../layouts/BaseLayout.astro';

const latestNews = (await getCollection('news', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime())
  .slice(0, 3);
---

<BaseLayout title="Home" description="Astro 6 portal starter for a VanillaPlus relaunch inspired by larger MMORPG project sites.">
  <section class="hero-section container">
    <div class="hero-copy">
      <p class="eyebrow">Community-driven Vanilla WoW project</p>
      <h1>Rebuild VanillaPlus into a full portal on Astro 6.</h1>
      <p class="hero-text">
        This rewrite turns VanillaPlus into a modern project website with large CTAs, account pages, donation flows,
        content collections, live-friendly widgets, and clean backend extension points for your development team.
      </p>
      <div class="hero-actions">
        <a class="button button-primary" href="/download">Download launcher</a>
        <a class="button button-secondary" href="/account/register">Create account</a>
        <a class="button button-ghost" href={siteConfig.discordUrl} target="_blank" rel="noreferrer">Join Discord</a>
      </div>
      <div class="hero-tags">
        <span>Astro 6</span>
        <span>Content collections</span>
        <span>React islands</span>
        <span>Donation flow</span>
        <span>SSR-ready</span>
      </div>
    </div>

    <aside class="hero-panel">
      <div class="hero-panel-card highlight">
        <p class="eyebrow">Current spotlight</p>
        <h2>Portal shell ready for your next season</h2>
        <p>Ship a cleaner home page, account experience, and community portal before plugging in your real services.</p>
      </div>
      <div class="hero-panel-grid">
        <a class="mini-card" href="/download">
          <strong>Download</strong>
          <span>Launcher, patch, mirrors</span>
        </a>
        <a class="mini-card" href="/account/login">
          <strong>Login</strong>
          <span>Session-ready demo flow</span>
        </a>
        <a class="mini-card" href="/donate">
          <strong>Donate</strong>
          <span>Checkout placeholder</span>
        </a>
        <a class="mini-card" href="/discord">
          <strong>Discord</strong>
          <span>Community hub</span>
        </a>
      </div>
    </aside>
  </section>

  <section class="container section-block">
    <SectionHeading
      eyebrow="Realm status"
      title="The portal already exposes live-friendly surfaces"
      description="Use React for dynamic widgets while Astro keeps the main site fast and easy to scale."
    />
    <ServerStatus client:load />
  </section>

  <section class="container section-block split-section">
    <div>
      <SectionHeading
        eyebrow="What this starter covers"
        title="A structure inspired by larger MMORPG project sites"
        description="The new design keeps VanillaPlus content readable while adding stronger hierarchy, polish, and room for future systems."
      />
      <FeatureGrid />
    </div>
    <div class="content-panel">
      <p class="eyebrow">Astro 6 checklist</p>
      <ul class="check-list">
        <li>Home page with stronger hero section and CTA stack</li>
        <li>Dedicated download, donate, Discord, and news pages</li>
        <li>Login, registration, recovery, and dashboard scaffolding</li>
        <li>Content collections for patch notes and announcements</li>
        <li>Mock API routes for auth, donation checkout, and server status</li>
        <li>Environment schema and Node 22-ready setup</li>
      </ul>
    </div>
  </section>

  <section class="container section-block community-band">
    <div>
      <p class="eyebrow">Community</p>
      <h2>Bring everything into one home.</h2>
      <p>
        The old VanillaPlus site already points players to account creation, launcher downloads, rules, rewards, and a
        talent calculator. This rebuild keeps those core entry points, but presents them as one cohesive hub instead of
        a small list of links.
      </p>
    </div>
    <div class="band-links">
      <a href={siteConfig.wikiUrl} target="_blank" rel="noreferrer">Open Wiki</a>
      <a href={siteConfig.talentCalculatorUrl} target="_blank" rel="noreferrer">Talent Calculator</a>
      <a href={siteConfig.supportUrl} target="_blank" rel="noreferrer">Support Project</a>
    </div>
  </section>

  <section class="container section-block">
    <SectionHeading
      eyebrow="News and updates"
      title="Announcements now live in Astro content collections"
      description="This page is no longer hard-coded to an array. Posts live in Markdown content entries and can grow into patch notes, guides, or a CMS-backed workflow later."
    />
    <NewsList posts={latestNews} />
  </section>
</BaseLayout>
